{
  "name": "torus-skills",
  "owner": {
    "name": "TORUS"
  },
  "metadata": {
    "description": "TORUS custom skills collection",
    "version": "1.0.0"
  },
  "plugins": [
    {
      "name": "torus-pptx",
      "description": "コンサルティングファーム風の高品質なPowerPointプレゼンテーション自動作成",
      "source": "./",
      "skills": [
        "./skills/pptx"
      ],
      "hooks": {
        "SessionStart": [
          {
            "matcher": "startup",
            "hooks": [
              {
                "type": "command",
                "command": "${CLAUDE_PLUGIN_ROOT}/scripts/setup.sh",
                "timeout": 300
              }
            ]
          }
        ]
      }
    }
  ]
}
